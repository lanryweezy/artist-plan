# Production Environment Configuration

# Application
NODE_ENV=production
NEXT_PUBLIC_API_URL=https://api.artist-plan.com
FRONTEND_URL=https://artist-plan.com
BACKEND_URL=https://api.artist-plan.com

# Database
MONGODB_URL=mongodb://admin:${MONGO_ROOT_PASSWORD}@mongodb:27017/artist_plan?authSource=admin
DATABASE_NAME=artist_plan
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=production_mongo_password_change_me_to_secure_password

# Redis
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
REDIS_PASSWORD=production_redis_password_change_me_to_secure_password

# Authentication
JWT_SECRET_KEY=production_jwt_secret_key_change_me_to_very_secure_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# AI Services
GOOGLE_GEMINI_API_KEY=your_production_gemini_api_key_here

# Payment Processing
STRIPE_SECRET_KEY=sk_live_your_production_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_live_your_production_stripe_publishable_key_here

# OAuth Integrations
SPOTIFY_CLIENT_ID=your_production_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_production_spotify_client_secret_here
GOOGLE_CLIENT_ID=your_production_google_client_id_here
GOOGLE_CLIENT_SECRET=your_production_google_client_secret_here

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreply@artist-plan.com
SMTP_PASSWORD=your_production_email_password_here

# Monitoring
GRAFANA_USER=admin
GRAFANA_PASSWORD=production_grafana_password_change_me_to_secure_password
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/production/webhook

# Backup
BACKUP_DIR=./backups
RETENTION_DAYS=30
AWS_S3_BUCKET=artist-plan-backups-production

# Security
CORS_ORIGINS=https://artist-plan.com
RATE_LIMIT_PER_MINUTE=60

# SSL (when using custom domain)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem