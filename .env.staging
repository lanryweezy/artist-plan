# Staging Environment Configuration

# Application
NODE_ENV=staging
NEXT_PUBLIC_API_URL=https://api-staging.artist-plan.com
FRONTEND_URL=https://staging.artist-plan.com
BACKEND_URL=https://api-staging.artist-plan.com

# Database
MONGODB_URL=mongodb://admin:${MONGO_ROOT_PASSWORD}@mongodb:27017/artist_plan_staging?authSource=admin
DATABASE_NAME=artist_plan_staging
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=staging_mongo_password_change_me

# Redis
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
REDIS_PASSWORD=staging_redis_password_change_me

# Authentication
JWT_SECRET_KEY=staging_jwt_secret_key_change_me_to_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# AI Services
GOOGLE_GEMINI_API_KEY=your_staging_gemini_api_key_here

# Payment Processing
STRIPE_SECRET_KEY=sk_test_your_staging_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_staging_stripe_publishable_key_here

# OAuth Integrations
SPOTIFY_CLIENT_ID=your_staging_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_staging_spotify_client_secret_here
GOOGLE_CLIENT_ID=your_staging_google_client_id_here
GOOGLE_CLIENT_SECRET=your_staging_google_client_secret_here

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreply@artist-plan.com
SMTP_PASSWORD=your_email_password_here

# Monitoring
GRAFANA_USER=admin
GRAFANA_PASSWORD=staging_grafana_password_change_me
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/staging/webhook

# Backup
BACKUP_DIR=./backups
RETENTION_DAYS=7
AWS_S3_BUCKET=artist-plan-backups-staging

# Security
CORS_ORIGINS=https://staging.artist-plan.com,http://localhost:3000
RATE_LIMIT_PER_MINUTE=100